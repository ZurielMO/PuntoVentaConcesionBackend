# Example only. Do not put real credentials in this file.
# Copia este archivo a `.env.local` y coloca valores reales ahí.
# En producción usa Firebase Secret Manager.

# ---------------------------------------------------------------------------
# Runtime / server
# ---------------------------------------------------------------------------
IS_LOCAL=true
NODE_ENV=development
PORT=3000
APP_PORT=3000

# ===========================================================================
# PROYECTO POS PRINCIPAL: puntoventacl - Firestore base nombrada "concesiones"
# ===========================================================================
PROJECT_ID=puntoventacl
FIREBASE_PROJECT_ID=puntoventacl
GCP_PROJECT_ID=puntoventacl
STORAGE_BUCKET=puntoventacl.firebasestorage.app
FIRESTORE_DATABASE_ID=concesiones

# Credenciales locales (una de estas opciones):
#  a) Coloca serviceAccountKey.json o serviceAccountPos.json en la raíz del repo.
#  b) Define la ruta absoluta:
GOOGLE_APPLICATION_CREDENTIALS=
#  c) Pega el JSON inline:
SERVICE_ACCOUNT_KEY=

# ===========================================================================
# AUTH UNIFICADO: app-oficial-leon (mismo stack que BackendCL)
# ===========================================================================
# Web API Key del proyecto app-oficial-leon (Identity Toolkit signInWithPassword).
FIREBASE_API_KEY=
CLIENT_FIREBASE_API_KEY=
AUTH_API_KEY=
WEB_API_KEY=

# OBLIGATORIO. Debe ser el MISMO valor que BackendCL (en local puedes usar cualquier string largo).
# Sin esto el login responde 500.
JWT_SECRET=cambia_este_secreto_local_compartido
JWT_EXPIRES_IN=7d

APP_OFICIAL_PROJECT_ID=app-oficial-leon
APP_OFICIAL_STORAGE_BUCKET=app-oficial-leon.firebasestorage.app
# Credenciales (una de estas opciones):
#  a) serviceAccountAppOficial.json en la raíz del repo.
#  b) ruta explícita:
SERVICE_ACCOUNT_APP_OFICIAL_PATH=
#  c) JSON inline:
SERVICE_ACCOUNT_APP_OFICIAL=

# ===========================================================================
# APP SECUNDARIA (solo jornadas): acreditaciones-b904f - Realtime Database
# ===========================================================================
REALTIME_DATABASE_URL_APP_OFICIAL2=https://acreditaciones-b904f-default-rtdb.firebaseio.com
# Credenciales (una de estas opciones):
#  a) acreditaciones-*-firebase-adminsdk-*.json en la raíz del repo (local).
#  b) ruta explícita:
SERVICE_ACCOUNT_APP_OFICIAL2_PATH=
#  c) JSON inline (también el secret de Gen2 apiV2):
SERVICE_ACCOUNT_APP_OFICIAL2=
#
# Producción (apiV2 Gen2) — el JSON NO viaja en el deploy; hay que subirlo a Secret Manager:
#   node scripts/set-jornada-secret-and-deploy.mjs
# o:
#   npx firebase-tools functions:secrets:set SERVICE_ACCOUNT_APP_OFICIAL2 --project puntoventacl --data-file=./acreditaciones-....json
#   npx firebase-tools deploy --only functions:apiV2 --project puntoventacl

# Cortesías trabajador club (RTDB acreditaciones -> subcolección usuariosApp/cortesias)
CORTESIAS_TORNEO_RTDB_PATH=torneo/liga mx/2026/apertura/partidos
CORTESIAS_TORNEO_LABEL=Apertura 2026

# ===========================================================================
# Integración de puntos de concesión -> backend app oficial (e-comerce-leon)
# ===========================================================================
# Prefijo hasta /usuarios (sin slash final). Un solo /api — no uses /api/api.
CONCESSION_POINTS_ASSIGN_URL=https://us-central1-e-comerce-leon.cloudfunctions.net/api/usuarios
CONCESSION_POINTS_SOURCE_SYSTEM=backendcl
CONCESSION_POINTS_SOURCE_SECRET=
ORIGIN_ID_SECRET=

# ---------------------------------------------------------------------------
# Integración BackendCL / Club León (proxy loyalty desde POS)
# ---------------------------------------------------------------------------
# URL base de BackendCL (sin slash final).
# Producción (Cloud Function `api`):
#   https://us-central1-e-comerce-leon.cloudfunctions.net/api
# Local (BackendCL en el host; las rutas Express viven bajo /api):
#   http://127.0.0.1:3001
# El helper buildBackendClApiUrl evita /api/api cuando la base ya termina en /api.
BACKENDCL_API_BASE_URL=https://us-central1-e-comerce-leon.cloudfunctions.net/api
# Opción A: token JWT estático (prioridad sobre email/password).
BACKENDCL_BEARER_TOKEN=
# Opción B: login automático vía POST /api/auth/register-or-login
# IMPORTANTE: la cuenta debe tener rol EMPLEADO o ADMIN en BackendCL (usuariosApp).
# Roles POS como CONCESION_VENDEDOR no pueden asignar puntos (asignar-por-venta).
BACKENDCL_AUTH_EMAIL=
BACKENDCL_AUTH_PASSWORD=
BACKENDCL_AUTH_NOMBRE=POS Integration
# Namespace de lealtad para el canje de puntos (reserve/confirm/cancel).
# Default: /api/loyalty/internal/v1 — es el prefijo que acepta el JWT de sesión.
# En /api/loyalty/v1 el router de partners OAuth intercepta y responde 401.
# Solo cambiar si BackendCL vuelve a mover el prefijo; si el default responde
# 401 o 404 el POS reintenta automáticamente con /api/loyalty/v1.
BACKENDCL_LOYALTY_BASE_PATH=/api/loyalty/internal/v1

# ---------------------------------------------------------------------------
# Abonados: las ofertas salen de Firestore `descuentos` (activos, por concesión).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Inventario cervecería: 1 vaso = N piezas (default 2)
# Matching por nombre ("vaso"+"cerveza" → "pieza"+"cerveza") en concesiones
# cuyo nombre contiene "cervecer". IDs opcionales para override.
# ---------------------------------------------------------------------------
CERVEZA_VASO_PRODUCT_IDS=
CERVEZA_PIEZA_PRODUCT_IDS=
CERVEZA_VASO_CONCESION_IDS=
CERVEZA_VASO_PIEZAS_PER_VASO=2

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://concesiones.clubleon.mx,http://concesiones.clubleon.mx,https://foodmarket.clubleon.mx,http://foodmarket.clubleon.mx
STORE_PUBLIC_BASE_URL=

# ===========================================================================
# VIP: Stripe Hosted Checkout y seguimiento de invitado
# ===========================================================================
# Secretos: en producción deben configurarse con Firebase Secret Manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VIP_TRACKING_SECRET=
# Valores no secretos.
STRIPE_CURRENCY=mxn
# Local (IS_LOCAL=true ignora el dominio de producción y usa VIP_PUBLIC_BASE_URL):
VIP_PUBLIC_BASE_URL=http://localhost:9002
VIP_CHECKOUT_SUCCESS_URL=http://localhost:9002/servicio-palcos/pago/exito?session_id={CHECKOUT_SESSION_ID}
VIP_CHECKOUT_CANCEL_URL=http://localhost:9002/servicio-palcos/pago/cancelado
# Producción:
# VIP_CHECKOUT_SUCCESS_URL=https://concesiones.clubleon.mx/servicio-palcos/pago/exito?session_id={CHECKOUT_SESSION_ID}
# VIP_CHECKOUT_CANCEL_URL=https://concesiones.clubleon.mx/servicio-palcos/pago/cancelado
VIP_RESERVATION_TTL_MINUTES=30
# Fallback en MXN; vip_service_configs/{jornadaId}.serviceFeeMinor tiene prioridad.
VIP_SERVICE_FEE=20

# Contraseña para fijar/cambiar el lado de Central VIP (Oriente / Poniente).
VIP_CENTRAL_ZONE_PASSWORD=Palcos.2026

# ===========================================================================
# Brevo (misma cuenta que BackendCL: OTP / contacto / VIP)
# ===========================================================================
# Secretos: en producción deben configurarse con Firebase Secret Manager.
#   firebase functions:secrets:set BREVO_API_KEY --project puntoventacl
#   firebase functions:secrets:set BREVO_SENDER_EMAIL --project puntoventacl
#   firebase functions:secrets:set BREVO_SENDER_NAME --project puntoventacl
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@clubleon.com
BREVO_SENDER_NAME=Club León
